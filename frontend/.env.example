# Sao chép file này thành .env rồi đổi giá trị theo môi trường của bạn
# (file .env đã được git ignore — không commit lên repo)

# Dev local (backend chạy ở cổng 5001)
API_URL=http://localhost:5001/api

# Khi build deploy: KHÔNG dùng file .env — đặt biến môi trường API_URL
# trên nền tảng deploy (vd. Cloudflare Pages → Settings → Environment variables)
